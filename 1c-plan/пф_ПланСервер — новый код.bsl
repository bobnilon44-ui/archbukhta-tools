// =====================================================================================================
// Общий модуль пф_ПланСервер (расширение «Производственный план») — доработка:
//   1) одна бригада: в каждый момент работает одна линия, линии делят часы смены;
//   2) в один день на линии — одна бутылка (ПЭТ); смена бутылки — долгая переналадка, бригада на это время
//      уходит на другую линию; бутылку держим, пока не кончатся её заказы;
//   3) китайская линия — отдельная (заказы со словом «Китай» в комментарии);
//   4) позиции плана подтягиваются из документов «Заказ на производство» при каждом пересчёте;
//   5) новые нормы по умолчанию.
//
// Что заменить / добавить — см. «Инструкция программисту.md» рядом с этим файлом.
// =====================================================================================================


// -----------------------------------------------------------------------------------------------------
// ЗАМЕНИТЬ целиком процедуру ЗаполнитьФасовкиПоУмолчанию
// -----------------------------------------------------------------------------------------------------

// Справочники по умолчанию: линии, фасовки с нормами (со слов цеха), смены, раскладка на паллеты (таблица цеха).
// Нормы для спрея и 2,7 л — примерные, их правят в «Фасовки, нормы и паллеты»; переналадку — в «Линиях».
Процедура ЗаполнитьФасовкиПоУмолчанию() Экспорт

	ЕстьФасовки = Справочники.пф_Фасовки.Выбрать().Следующий();
	Если ЕстьФасовки И Справочники.пф_Линии.Выбрать().Следующий() Тогда
		ДобавитьКитайскуюЛинию();
		ЗаполнитьУпаковкиПоУмолчанию();
		ЗаполнитьСменыПоУмолчанию();
		Возврат;
	КонецЕсли;

	// Линия | переналадка на другую бутылку, ч | для Китая
	Линии = Новый Соответствие;
	Порядок = 0;
	Для Каждого Строка Из СтрРазделить("Спрей|0|0;Стекло|11|0;Литровая (0,8–1 л)|11|0;Пятилитровая — Россия (2,7–5 л)|11|0;Китайская (4,8–5 л)|11|1", ";") Цикл
		Ч = СтрРазделить(Строка, "|");
		Порядок = Порядок + 1;
		Линия = Справочники.пф_Линии.СоздатьЭлемент();
		Линия.Наименование = Ч[0];
		Линия.Порядок = Порядок;
		Линия.ПереналадкаЧасов = Число(Ч[1]);
		Линия.ДляКитая = Ч[2] = "1";
		Линия.Записать();
		Линии.Вставить(Порядок, Линия.Ссылка);
	КонецЦикла;

	// Фасовка | от, л | до, л | линия | норма шт/ч | норма Китай шт/ч
	// 0,8–0,9 считаем как литровые; заказы «Китай» идут на китайскую линию с нормой 672.
	Данные = "0,2 спрей|0|0,24|1|0|0
	|0,25–0,5 стекло|0,25|0,5|2|960|0
	|0,8–0,9|0,7|0,95|3|5000|0
	|1|0,96|1,5|3|5000|0
	|2,7|2|3|4|1200|0
	|4,5–4,8|4|4,9|4|1200|672
	|5|4,95|6|4|1200|672
	|Прочие|0|0|4|0|0";
	Порядок = 0;
	Для Каждого Строка Из СтрРазделить(Данные, Символы.ПС) Цикл
		Части = СтрРазделить(Строка, "|");
		Порядок = Порядок + 1;
		// Обновление с прошлой версии: фасовки уже есть, но без линий и норм — дополняем их по названию.
		Если ЕстьФасовки Тогда
			Существующая = Справочники.пф_Фасовки.НайтиПоНаименованию(СокрЛП(Части[0]), Истина);
			Если Не Существующая.Пустая() Тогда
				Фасовка = Существующая.ПолучитьОбъект();
				Фасовка.Линия = Линии[Число(Части[3])];
				Фасовка.НормаШтЧас = Число(Части[4]);
				Фасовка.НормаКитайШтЧас = Число(Части[5]);
				Фасовка.ЛимитПаллетВДень = ?(Фасовка.НормаШтЧас = 0, Фасовка.ЛимитПаллетВДень, 0);
				Фасовка.Записать();
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Фасовка = Справочники.пф_Фасовки.СоздатьЭлемент();
		Фасовка.Наименование = СокрЛП(Части[0]);
		Фасовка.ОбъемОт = Число(СтрЗаменить(СокрЛП(Части[1]), ",", "."));
		Фасовка.ОбъемДо = Число(СтрЗаменить(СокрЛП(Части[2]), ",", "."));
		Фасовка.Линия = Линии[Число(Части[3])];
		Фасовка.НормаШтЧас = Число(Части[4]);
		Фасовка.НормаКитайШтЧас = Число(Части[5]);
		Фасовка.ЛимитПаллетВДень = ?(Фасовка.НормаШтЧас = 0, 20, 0); // без нормы — хотя бы лимит паллет
		Фасовка.Порядок = Порядок;
		Фасовка.Записать();
	КонецЦикла;
	ЗаполнитьУпаковкиПоУмолчанию();
	ЗаполнитьСменыПоУмолчанию();

КонецПроцедуры

// В базе, где линии уже заведены прежней версией, китайской линии нет — заводим один раз.
Процедура ДобавитьКитайскуюЛинию()
	Если ЗначениеЗаполнено(ЛинияКитая()) Тогда
		Возврат;
	КонецЕсли;
	Линия = Справочники.пф_Линии.СоздатьЭлемент();
	Линия.Наименование = "Китайская (4,8–5 л)";
	Линия.Порядок = 5;
	Линия.ПереналадкаЧасов = 11;
	Линия.ДляКитая = Истина;
	Линия.Записать();
КонецПроцедуры

// Линия, на которую идут заказы «Китай» (галочка «Для Китая» в «Линиях»). Пустая — китайской линии нет.
Функция ЛинияКитая() Экспорт
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Л.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.пф_Линии КАК Л
	|ГДЕ
	|	Л.ДляКитая
	|	И НЕ Л.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|	Л.Порядок");
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Справочники.пф_Линии.ПустаяСсылка());
КонецФункции


// -----------------------------------------------------------------------------------------------------
// ЗАМЕНИТЬ целиком процедуру Пересчитать
// -----------------------------------------------------------------------------------------------------

// Пересчитывает план: заказы на производство, «сделано» по отчётам смен, статусы, раскладка по дням.
//
// Бригада одна, поэтому в каждый момент работает одна линия: часы смены — общие на все линии.
// На линии в один день стоит только одна бутылка (0,8, 0,9 и 1 л — разные бутылки, хоть норма и одна).
// Сменить бутылку — переналадка («Переналадка, ч» в «Линиях»): пока её делают, бригада работает на другой
// линии, а новая бутылка начинается не раньше следующего дня. Поэтому:
//   1. Самый срочный заказ (закреплённые, потом «Срочно», «Высокая», внутри — по сроку) — «главный».
//   2. Если на его линии стоит другая бутылка, сначала доделываем заказы на эту бутылку
//      со сроком не позже главного + ОкноПартииДней() — чтобы не перенастраивать линию туда-обратно.
//   3. Потом запускаем переналадку, а бригада пока делает самое срочное на других линиях.
//   4. Если последняя паллета выходит позже срока — позиция «не успевает» (красная).
// Позиции без нормы (спрей) раскладываются, как раньше, по лимиту паллет в день и часы бригады не занимают.
Процедура Пересчитать(Знач Сегодня = Неопределено) Экспорт

	Если Сегодня = Неопределено Тогда
		Сегодня = НачалоДня(ТекущаяДатаСеанса());
	КонецЕсли;
	ЗагрузитьИзЗаказовНаПроизводство();
	Настройки = Настройки();
	ОсобыеДни = ОсобыеДни();
	Горизонт = 180; // дней вперёд

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Сегодня", Сегодня);
	Запрос.УстановитьПараметр("МесяцНазад", Сегодня - 31 * 86400);
	Запрос.УстановитьПараметр("ЛинияКитая", ЛинияКитая());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Вып.Позиция КАК Позиция,
	|	СУММА(Вып.Паллет) КАК Паллет
	|ПОМЕСТИТЬ Сделано
	|ИЗ
	|	РегистрСведений.пф_Выпуск КАК Вып
	|СГРУППИРОВАТЬ ПО
	|	Вып.Позиция
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	П.Ссылка КАК Ссылка,
	|	П.Фасовка КАК Фасовка,
	|	ВЫБОР
	|		КОГДА П.Китай И &ЛинияКитая <> ЗНАЧЕНИЕ(Справочник.пф_Линии.ПустаяСсылка)
	|			ТОГДА &ЛинияКитая
	|		ИНАЧЕ ЕСТЬNULL(П.Фасовка.Линия, ЗНАЧЕНИЕ(Справочник.пф_Линии.ПустаяСсылка))
	|	КОНЕЦ КАК Линия,
	|	ЕСТЬNULL(П.Фасовка.ЛимитПаллетВДень, 0) КАК ЛимитФасовки,
	|	ВЫБОР
	|		КОГДА П.Китай И ЕСТЬNULL(П.Фасовка.НормаКитайШтЧас, 0) > 0
	|			ТОГДА П.Фасовка.НормаКитайШтЧас
	|		ИНАЧЕ ЕСТЬNULL(П.Фасовка.НормаШтЧас, 0)
	|	КОНЕЦ КАК Норма,
	|	П.ШтНаПаллете КАК ШтНаПаллете,
	|	П.Объем КАК Объем,
	|	П.Паллет КАК Паллет,
	|	ЕСТЬNULL(Сделано.Паллет, 0) КАК Сделано,
	|	П.Срок КАК Срок,
	|	П.Статус КАК Статус,
	|	П.Закреплено КАК Закреплено,
	|	П.ДатаЗакрепления КАК ДатаЗакрепления,
	|	ВЫБОР
	|		КОГДА П.Важность = ЗНАЧЕНИЕ(Перечисление.пф_Важность.Срочно) ТОГДА 0
	|		КОГДА П.Важность = ЗНАЧЕНИЕ(Перечисление.пф_Важность.Высокая) ТОГДА 1
	|		ИНАЧЕ 2
	|	КОНЕЦ КАК Порядок,
	|	ВЫБОР
	|		КОГДА П.Срок = ДАТАВРЕМЯ(1, 1, 1) ТОГДА ДАТАВРЕМЯ(3999, 1, 1)
	|		ИНАЧЕ П.Срок
	|	КОНЕЦ КАК СрокДляСортировки
	|ИЗ
	|	Справочник.пф_ПозицииПлана КАК П
	|		ЛЕВОЕ СОЕДИНЕНИЕ Сделано КАК Сделано
	|		ПО (Сделано.Позиция = П.Ссылка)
	|ГДЕ
	|	НЕ П.ПометкаУдаления
	|	И П.Статус <> ЗНАЧЕНИЕ(Перечисление.пф_СтатусыПозиций.Отменено)
	|УПОРЯДОЧИТЬ ПО
	|	Закреплено УБЫВ,
	|	Порядок,
	|	СрокДляСортировки,
	|	П.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Вып.Позиция КАК Позиция,
	|	Вып.Дата КАК Дата,
	|	Вып.Паллет КАК Паллет
	|ИЗ
	|	РегистрСведений.пф_Выпуск КАК Вып
	|ГДЕ
	|	Вып.Дата МЕЖДУ &МесяцНазад И &Сегодня
	|УПОРЯДОЧИТЬ ПО
	|	Вып.Дата";
	Результаты = Запрос.ВыполнитьПакет();
	Позиции = Результаты[1].Выгрузить();
	Позиции.Колонки.Добавить("Остаток", Новый ОписаниеТипов("Число"));
	Позиции.Колонки.Добавить("ПаллетВЧас", Новый ОписаниеТипов("Число"));
	Позиции.Колонки.Добавить("Объект");

	// 1. Сделано, статусы, остатки.
	Для Каждого П Из Позиции Цикл
		Объект = П.Ссылка.ПолучитьОбъект();
		Объект.СделаноПаллет = П.Сделано;
		Если Объект.ШтНаПаллете = 0 И П.Объем > 0 Тогда
			Объект.ШтНаПаллете = ШтНаПаллетеПоУмолчанию(П.Объем);
			П.ШтНаПаллете = Объект.ШтНаПаллете;
		КонецЕсли;
		Объект.Статус = СтатусПоВыпуску(П.Паллет, П.Сделано, Объект.Статус);
		Если Объект.Статус = Перечисления.пф_СтатусыПозиций.Выполнено И Не ЗначениеЗаполнено(Объект.ДатаВыполнения) Тогда
			Объект.ДатаВыполнения = Сегодня;
		ИначеЕсли Объект.Статус <> Перечисления.пф_СтатусыПозиций.Выполнено Тогда
			Объект.ДатаВыполнения = '00010101';
		КонецЕсли;
		Объект.ПлановоеНачало = '00010101';
		Объект.ПлановоеОкончание = '00010101';
		Объект.Опаздывает = Ложь;
		П.Объект = Объект;
		П.Остаток = Макс(П.Паллет - П.Сделано, 0);
		П.ПаллетВЧас = ПаллетВЧас(П);
	КонецЦикла;

	// 2. Какая бутылка стоит на каждой линии и сколько часов бригады уже ушло сегодня — по отчётам смен.
	Линии = Новый Соответствие; // Линия -> Структура("Объем, ГотоваС, ПоследнийДень, Переналадка")
	ЗанятоЧасов = Новый Соответствие; // номер дня от сегодня -> часы бригады, уже отданные под выпуск / закреплённые
	Выборка = Результаты[2].Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаПоз = Позиции.Найти(Выборка.Позиция, "Ссылка");
		Если СтрокаПоз = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Сост = СостояниеЛинии(Линии, СтрокаПоз.Линия);
		Если СтрокаПоз.Объем > 0 Тогда
			Сост.Объем = СтрокаПоз.Объем;
		КонецЕсли;
		Если Выборка.Дата = Сегодня Тогда
			Сост.ПоследнийДень = 0;
			Если СтрокаПоз.ПаллетВЧас > 0 Тогда
				ЗанятоЧасов.Вставить(0, Получить(ЗанятоЧасов, 0) + Выборка.Паллет / СтрокаПоз.ПаллетВЧас);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	План = Новый Соответствие; // Позиция -> (День -> паллет)

	// 3. Закреплённые вручную ставятся на свою дату целиком (даже сверх часов — тогда день красный).
	Для Каждого П Из Позиции Цикл
		Если П.Остаток > 0 И П.Закреплено И ЗначениеЗаполнено(П.ДатаЗакрепления) Тогда
			День = Макс(НачалоДня(П.ДатаЗакрепления), Сегодня);
			Поставить(План, П, День, П.Остаток);
			Если П.ПаллетВЧас > 0 Тогда
				НомерДня = (День - Сегодня) / 86400;
				ЗанятоЧасов.Вставить(НомерДня, Получить(ЗанятоЧасов, НомерДня) + П.Остаток / П.ПаллетВЧас);
			КонецЕсли;
			П.Остаток = 0;
		КонецЕсли;
	КонецЦикла;

	// 4. Календарь бригады: дни подряд, часы — сплошной шкалой (Начало/Конец дня — в часах от сегодняшнего утра).
	Дни = Новый Массив;
	Шкала = 0;
	Для Шаг = 0 По Горизонт Цикл
		День = Сегодня + Шаг * 86400;
		Часов = Макс(ЧасыДня(День, Настройки, ОсобыеДни) - Получить(ЗанятоЧасов, Шаг), 0);
		Дни.Добавить(Новый Структура("Дата, Начало, Конец", День, Шкала, Шкала + Часов));
		Шкала = Шкала + Часов;
	КонецЦикла;

	// 5. Остальное — бригадой, по одной линии за раз.
	Курсор = 0;
	НомерДня = 0;
	Пока Курсор < Шкала Цикл
		П = ВыбратьПозицию(Позиции, Линии, Курсор, Дни);
		Если П = Неопределено Тогда
			// Всё, что осталось, ждёт переналадки — бригада ждёт ближайшую готовую линию.
			Курсор = БлижайшаяГотовность(Линии, Курсор);
			Продолжить;
		КонецЕсли;
		Пока НомерДня < Дни.ВГраница() И Курсор >= Дни[НомерДня].Конец Цикл
			НомерДня = НомерДня + 1;
		КонецЦикла;
		Взять = Мин(П.Остаток, Цел((Дни[НомерДня].Конец - Курсор) * П.ПаллетВЧас * 10) / 10);
		Если Взять <= 0 Тогда
			Курсор = Дни[НомерДня].Конец; // до конца дня не успеть и 0,1 паллеты — со следующего дня
			Продолжить;
		КонецЕсли;
		Поставить(План, П, Дни[НомерДня].Дата, Взять);
		Курсор = Курсор + Взять / П.ПаллетВЧас;
		П.Остаток = П.Остаток - Взять;
		Сост = СостояниеЛинии(Линии, П.Линия);
		Если П.Объем > 0 Тогда
			Сост.Объем = П.Объем;
		КонецЕсли;
		Сост.ПоследнийДень = НомерДня;
	КонецЦикла;

	// 6. Без нормы (спрей) — по лимиту паллет в день, как раньше; часы бригады не занимают.
	Занято = Новый Структура("Фасовка, Всего, ЧасыЛинии", Новый Соответствие, Новый Соответствие, Новый Соответствие);
	Для Каждого П Из Позиции Цикл
		Если П.Остаток <= 0 Или П.ПаллетВЧас > 0 Тогда
			Продолжить;
		КонецЕсли;
		Для Шаг = 0 По Горизонт Цикл
			День = Сегодня + Шаг * 86400;
			Взять = Мин(П.Остаток, СвободноВДень(Занято, П, 0, Настройки, ЧасыДня(День, Настройки, ОсобыеДни), День));
			Если Взять > 0 Тогда
				Поставить(План, П, День, Взять);
				Занять(Занято, П.Фасовка, П.Линия, День, Взять, 0);
				П.Остаток = П.Остаток - Взять;
			КонецЕсли;
			Если П.Остаток <= 0 Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	// 7. Запись: план по дням, плановые даты, «не успевает».
	Набор = РегистрыСведений.пф_ПланПоДням.СоздатьНаборЗаписей();
	НачатьТранзакцию();
	Попытка
		Для Каждого П Из Позиции Цикл
			Объект = П.Объект;
			Если П.Остаток > 0 Тогда
				Объект.ПлановоеОкончание = Сегодня + Горизонт * 86400; // не поместилось за горизонт
			КонецЕсли;
			Объект.Опаздывает = ЗначениеЗаполнено(П.Срок) И Объект.ПлановоеОкончание > П.Срок;
			Если Объект.Модифицированность() Тогда
				Объект.ОбменДанными.Загрузка = Истина;
				Объект.Записать();
			КонецЕсли;
		КонецЦикла;
		Для Каждого ПоПозиции Из План Цикл
			Для Каждого ПоДню Из ПоПозиции.Значение Цикл
				ДобавитьВПлан(Набор, ПоПозиции.Ключ, ПоДню.Ключ, ПоДню.Значение);
			КонецЦикла;
		КонецЦикла;
		Набор.Записать(Истина);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Заказы на одну бутылку со сроком не позже главного заказа + столько дней делаем подряд, не перенастраивая линию.
Функция ОкноПартииДней()
	Возврат 7;
КонецФункции


// -----------------------------------------------------------------------------------------------------
// ДОБАВИТЬ в область ПрограммныйИнтерфейс (после ЗагрузитьТаблицу)
// -----------------------------------------------------------------------------------------------------

// Заказы на производство УНФ -> позиции плана. Вызывается в начале каждого пересчёта.
// Берём проведённые заказы в состоянии «В работе»; строка продукции = позиция плана (ключ «ЗНП|<заказ>|<строка>»).
// Литраж — из наименования номенклатуры («… 1 л», «… 0,9л»), количество — в штуках, паллеты — по раскладке.
// «Китай» в комментарии заказа — китайская линия и её норма. Срок — дата окончания заказа.
// Заказ сняли с работы или удалили — его незавершённые позиции отменяются.
// Важность и закрепление, выставленные в плане вручную, не трогаем.
Процедура ЗагрузитьИзЗаказовНаПроизводство() Экспорт

	ЗаполнитьФасовкиПоУмолчанию();

	// ПРОВЕРИТЬ на копии имена: ТЧ «Продукция», реквизиты «Окончание», «СостояниеЗаказа», «Ответственный»,
	// реквизит состояния «СтатусЗаказа» и значение «ВРаботе».
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Прод.Ссылка КАК Заказ,
	|	Прод.НомерСтроки КАК НомерСтроки,
	|	Прод.Номенклатура КАК Номенклатура,
	|	Прод.Номенклатура.Наименование КАК Товар,
	|	Прод.Количество КАК Количество,
	|	Прод.Ссылка.Номер КАК Номер,
	|	Прод.Ссылка.Окончание КАК Срок,
	|	Прод.Ссылка.Комментарий КАК Комментарий,
	|	ПРЕДСТАВЛЕНИЕ(Прод.Ссылка.Ответственный) КАК Менеджер
	|ИЗ
	|	Документ.ЗаказНаПроизводство.Продукция КАК Прод
	|ГДЕ
	|	Прод.Ссылка.Проведен
	|	И Прод.Ссылка.СостояниеЗаказа.СтатусЗаказа = ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказов.ВРаботе)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	П.Ссылка КАК Ссылка,
	|	П.КлючЗагрузки КАК КлючЗагрузки
	|ИЗ
	|	Справочник.пф_ПозицииПлана КАК П
	|ГДЕ
	|	П.КлючЗагрузки ПОДОБНО ""ЗНП|%""
	|	И НЕ П.ПометкаУдаления
	|	И НЕ П.Статус В (ЗНАЧЕНИЕ(Перечисление.пф_СтатусыПозиций.Выполнено), ЗНАЧЕНИЕ(Перечисление.пф_СтатусыПозиций.Отменено))");
	Результаты = Запрос.ВыполнитьПакет();

	ВРаботе = Новый Соответствие;
	Выборка = Результаты[0].Выбрать();
	Пока Выборка.Следующий() Цикл
		Ключ = СтрШаблон("ЗНП|%1|%2", Выборка.Заказ.УникальныйИдентификатор(), Выборка.НомерСтроки);
		ВРаботе.Вставить(Ключ, Истина);
		Ссылка = Справочники.пф_ПозицииПлана.НайтиПоРеквизиту("КлючЗагрузки", Ключ);
		Если Ссылка.Пустая() Тогда
			Позиция = Справочники.пф_ПозицииПлана.СоздатьЭлемент();
			Позиция.КлючЗагрузки = Ключ;
			Позиция.Основание = Выборка.Заказ;
			Позиция.Важность = Перечисления.пф_Важность.Обычная;
			Позиция.Статус = Перечисления.пф_СтатусыПозиций.Запланировано;
		ИначеЕсли Ссылка.Статус = Перечисления.пф_СтатусыПозиций.Выполнено
			Или Ссылка.Статус = Перечисления.пф_СтатусыПозиций.Отменено Тогда
			Продолжить;
		Иначе
			Позиция = Ссылка.ПолучитьОбъект();
		КонецЕсли;

		Объем = ОбъемИзНаименования(Выборка.Товар);
		Позиция.Наименование = Лев(Выборка.Товар, 150);
		Позиция.Номенклатура = Выборка.Номенклатура;
		Если Позиция.Объем <> Объем Или Не ЗначениеЗаполнено(Позиция.Фасовка) Тогда
			Позиция.Объем = Объем;
			Позиция.Фасовка = ФасовкаПоОбъему(Объем);
			Позиция.ШтНаПаллете = ШтНаПаллетеПоУмолчанию(Объем);
		КонецЕсли;
		Позиция.Китай = СтрНайти(НРег(Выборка.Комментарий + " " + Выборка.Товар), "китай") > 0;
		Позиция.Паллет = ?(Позиция.ШтНаПаллете > 0, Окр(Выборка.Количество / Позиция.ШтНаПаллете, 1), 0);
		Позиция.Срок = ?(ЗначениеЗаполнено(Выборка.Срок), НачалоДня(Выборка.Срок), '00010101');
		Позиция.Менеджер = Выборка.Менеджер;
		Позиция.Комментарий = Лев(СтрШаблон("Заказ № %1. %2", СокрЛП(Выборка.Номер), Выборка.Комментарий), 250);
		Если Позиция.ЭтоНовый() Или Позиция.Модифицированность() Тогда
			Позиция.Записать();
		КонецЕсли;
	КонецЦикла;

	// Заказ больше не «в работе» — его позиции уходят из плана.
	Выборка = Результаты[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ВРаботе[Выборка.КлючЗагрузки] = Неопределено Тогда
			Позиция = Выборка.Ссылка.ПолучитьОбъект();
			Позиция.Статус = Перечисления.пф_СтатусыПозиций.Отменено;
			Позиция.Записать();
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры


// -----------------------------------------------------------------------------------------------------
// ДОБАВИТЬ в область СлужебныеПроцедурыИФункции
// -----------------------------------------------------------------------------------------------------

// Что сейчас делать бригаде (см. пояснение к Пересчитать). Неопределено — всё оставшееся ждёт переналадки.
Функция ВыбратьПозицию(Позиции, Линии, Курсор, Дни)

	Главная = Неопределено;
	Для Каждого П Из Позиции Цикл
		Если П.Остаток > 0 И П.ПаллетВЧас > 0 Тогда
			Главная = П;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Главная = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Сост = СостояниеЛинии(Линии, Главная.Линия);
	Если Не Подходит(Сост, Главная) Тогда
		// На линии другая бутылка: сначала доделываем её заказы, если они не сильно позже главного.
		Если Сост.ГотоваС <= Курсор Тогда
			Граница = Главная.СрокДляСортировки + ОкноПартииДней() * 86400;
			Для Каждого П Из Позиции Цикл
				Если П.Остаток > 0 И П.ПаллетВЧас > 0 И П.Линия = Главная.Линия И П.Объем = Сост.Объем
					И П.Порядок = Главная.Порядок И П.СрокДляСортировки <= Граница Тогда
					Возврат П;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		// Переналадка под главный заказ; новая бутылка — не раньше следующего дня после старой.
		Сост.Объем = Главная.Объем;
		Сост.ГотоваС = МоментГотовности(Дни, Макс(Курсор, Сост.ГотоваС) + Сост.Переналадка, Сост.ПоследнийДень);
	КонецЕсли;
	Если Сост.ГотоваС <= Курсор Тогда
		Возврат Главная;
	КонецЕсли;

	// Линия главного заказа на переналадке — бригада делает самое срочное на других линиях.
	Для Каждого П Из Позиции Цикл
		Если П.Остаток > 0 И П.ПаллетВЧас > 0 И П.Линия <> Главная.Линия Тогда
			Другая = СостояниеЛинии(Линии, П.Линия);
			Если Другая.ГотоваС <= Курсор И Подходит(Другая, П) Тогда
				Возврат П;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Бутылка позиции совпадает с той, что стоит на линии (или одна из них неизвестна).
Функция Подходит(Сост, П)
	Возврат Сост.Объем = 0 Или П.Объем = 0 Или Сост.Объем = П.Объем;
КонецФункции

Функция СостояниеЛинии(Линии, Линия)
	Сост = Линии[Линия];
	Если Сост = Неопределено Тогда
		Сост = Новый Структура("Объем, ГотоваС, ПоследнийДень, Переналадка", 0, 0, -1,
			?(ЗначениеЗаполнено(Линия), Линия.ПереналадкаЧасов, 0));
		Линии.Вставить(Линия, Сост);
	КонецЕсли;
	Возврат Сост;
КонецФункции

// Начало первого дня после ПоследнийДень, который начинается не раньше Момент (часы по шкале бригады).
Функция МоментГотовности(Дни, Момент, ПоследнийДень)
	Для Индекс = Макс(ПоследнийДень + 1, 0) По Дни.ВГраница() Цикл
		Если Дни[Индекс].Начало >= Момент Тогда
			Возврат Дни[Индекс].Начало;
		КонецЕсли;
	КонецЦикла;
	Возврат Дни[Дни.ВГраница()].Конец; // за горизонтом
КонецФункции

// Ближайший момент, когда закончится какая-нибудь переналадка (или конец горизонта).
Функция БлижайшаяГотовность(Линии, Курсор)
	Результат = Неопределено;
	Для Каждого Элемент Из Линии Цикл
		Если Элемент.Значение.ГотоваС > Курсор И (Результат = Неопределено Или Элемент.Значение.ГотоваС < Результат) Тогда
			Результат = Элемент.Значение.ГотоваС;
		КонецЕсли;
	КонецЦикла;
	Возврат ?(Результат = Неопределено, 999999999, Результат);
КонецФункции

// Ставит паллеты позиции на день и отмечает плановые даты.
Процедура Поставить(План, П, День, Паллет)
	Прибавить(План, П.Ссылка, День, Паллет);
	Если Не ЗначениеЗаполнено(П.Объект.ПлановоеНачало) Тогда
		П.Объект.ПлановоеНачало = День;
	КонецЕсли;
	П.Объект.ПлановоеОкончание = Макс(П.Объект.ПлановоеОкончание, День);
КонецПроцедуры

// «Масло 5W-30 1 л» -> 1, «… 0,9л» -> 0.9, «канистра 4.8 л» -> 4.8, «… 5 литров» -> 5.
// Берём число прямо перед «л» (последнее такое в названии). Не нашли — 0.
Функция ОбъемИзНаименования(Знач Текст)
	Текст = СтрЗаменить(НРег(Текст), ",", ".");
	Буквы = "абвгдеёжзийклмнопрстуфхцчшщъыьэюяabcdefghijklmnopqrstuvwxyz";
	Результат = 0;
	Для Индекс = 1 По СтрДлина(Текст) Цикл
		Если Сред(Текст, Индекс, 1) <> "л" Тогда
			Продолжить;
		КонецЕсли;
		Следующий = Сред(Текст, Индекс + 1, 1);
		Если Следующий <> "" И СтрНайти(Буквы, Следующий) > 0 И Не СтрНачинаетсяС(Сред(Текст, Индекс), "литр") Тогда
			Продолжить; // «л» внутри слова
		КонецЕсли;
		Конец = Индекс - 1;
		Пока Конец > 0 И Сред(Текст, Конец, 1) = " " Цикл
			Конец = Конец - 1;
		КонецЦикла;
		Начало = Конец;
		Пока Начало > 0 И СтрНайти("0123456789.", Сред(Текст, Начало, 1)) > 0 Цикл
			Начало = Начало - 1;
		КонецЦикла;
		Значение = ЧислоИзТекста(Сред(Текст, Начало + 1, Конец - Начало));
		Если Значение > 0 Тогда
			Результат = Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции
